# ==============================================================================
# GMIU CE & IT Portal — Enterprise-Grade Apache Security & Hardening (.htaccess)
# Architecture: FastRoute Front Controller + High-Performance HLS Streaming
# Target Environments: Local XAMPP & Production Web Hosts (InfinityFree, cPanel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER HARDENING & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Disable directory listing/browsing and MultiViews guessing; enforce symlinks



Options -Indexes -MultiViews +FollowSymLinks

# Suppress server signature details on error pages
ServerSignature Off

# ------------------------------------------------------------------------------
# 2. UNIVERSAL SHIELD: BLOCK SENSITIVE FILES, REPOSITORIES & DEPENDENCIES
# ------------------------------------------------------------------------------
# Block critical configuration, credential, dependency manifests, and scripts
<FilesMatch "^(\.env|\.git|\.github|\.pwd|\.htaccess|\.htpasswd|\.gitignore|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|plan\.md|README\.md|set_page_colors\.py|users\.json|timetableData\.js|timetable_data\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block all backup, database, configuration, shell, and script file extensions
<FilesMatch "\.(env|sql|sqlite|db|log|bak|old|orig|swp|save|temp|tmp|ini|cfg|conf|sh|bash|py|pyc|dist|yml|yaml|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 3. HTTP SECURITY HEADERS (DEFENSE-IN-DEPTH)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # Prevent Clickjacking by restricting framing to same origin
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME-Type Sniffing attacks
    Header always set X-Content-Type-Options "nosniff"

    # Enforce browser Cross-Site Scripting (XSS) filter
    Header always set X-XSS-Protection "1; mode=block"

    # Prevent sensitive URL token leakage via Referrer header
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Disable risky browser hardware APIs for third-party scripts
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # Remove server technology fingerprints from HTTP headers
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# ------------------------------------------------------------------------------
# 4. REWRITE ENGINE & WEB APPLICATION FIREWALL (WAF)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 4.1 Block direct access to hidden files/folders (starting with dot, except .well-known)
    RewriteCond %{REQUEST_URI} "!/\.well-known/" [NC]
    RewriteRule "(^|/)\." - [F,L]

    # 4.2 Block direct web access to internal architecture directories
    RewriteRule ^(App|Core|config|routes|vendor|scratch|\.github|\.git)/ - [F,L]

    # 4.3 Anti-Webshell: Block any direct execution of PHP/scripts in uploads/ & assets/
    RewriteRule ^(uploads|assets)/.*\.php[0-9]?$ - [F,L]
    RewriteRule ^(uploads|assets)/.*\.(phtml|phar|inc|cgi|pl|py|sh|exe|bat|cmd)$ - [F,L]

    # 4.4 Block Dangerous HTTP Methods (Allow only standard web methods: GET, POST, PUT, DELETE, OPTIONS, HEAD)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG|CONNECT) [NC]
    RewriteRule ^ - [F,L]

    # 4.5 Block Path Traversal (Directory Traversal / LFI)
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e\/|\.\.%2f|%2e%2e%5c) [NC,OR]
    RewriteCond %{THE_REQUEST} (\.\./|\.\.\\|%2e%2e%2f|%2e%2e\/|\.\.%2f|%2e%2e%5c) [NC]
    RewriteRule ^ - [F,L]

    # 4.6 Block Remote File Inclusion (RFI) & Stream Wrappers
    RewriteCond %{QUERY_STRING} (php://|data://|zip://|phar://|expect://|glob://) [NC,OR]
    RewriteCond %{QUERY_STRING} (https?|ftp):// [NC]
    RewriteRule ^ - [F,L]

    # 4.7 Block SQL Injection (SQLi) Signatures in Query String
    RewriteCond %{QUERY_STRING} (union(.*)select|select(.*)from|insert(.*)into|drop(.*)table|drop(.*)database|information_schema|benchmark\s*\(|sleep\s*\(|group_concat|order\s+by\s+\d+|waitfor\s+delay) [NC,OR]
    RewriteCond %{QUERY_STRING} (concat\s*\(|char\s*\(|load_file|outfile|into\s+dumpfile) [NC]
    RewriteRule ^ - [F,L]

    # 4.8 Block Cross-Site Scripting (XSS) & Code Execution Injections in Query String
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (javascript:|vbscript:|data:text/html|onload=|onerror=|onclick=|onmouseover=) [NC,OR]
    RewriteCond %{QUERY_STRING} (base64_encode|base64_decode|eval\(|passthru\(|shell_exec\(|system\() [NC]
    RewriteRule ^ - [F,L]

    # 4.9 Block Known Malicious Vulnerability Scanners & Hack Tools
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|havij|acunetix|dirbuster|gobuster|wpscan|masscan|zgrab|morfeus|nessus) [NC]
    RewriteRule ^ - [F,L]

    # 4.10 Allow direct access to legitimate static assets (CSS, JS, media, fonts, HLS streams)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} \.(css|js|ico|png|jpe?g|gif|svg|webp|woff2?|ttf|eot|xlsx?|pdf|zip|mp4|webm|ogg|mov|m4v|m3u8|ts)$ [NC]
    RewriteRule ^ - [L]

    # 4.11 FastRoute Front Controller: Route all other requests through index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. MIME TYPES FOR HLS VIDEO STREAMING & MODERN ASSETS
# ------------------------------------------------------------------------------
AddType application/vnd.apple.mpegurl .m3u8
AddType video/mp2t .ts
AddType video/mp4 .mp4
AddType image/webp .webp

# ------------------------------------------------------------------------------
# 6. PERFORMANCE OPTIMIZATION: GZIP COMPRESSION & CACHING
# ------------------------------------------------------------------------------
# Enable Gzip compression for text, scripts, stylesheets, and data streams
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript application/json application/xml image/svg+xml application/vnd.apple.mpegurl
</IfModule>

# Smart Asset Caching
<IfModule mod_headers.c>
    # Static UI assets: cache for 7 days
    <FilesMatch "\.(js|css|ico|png|jpg|jpeg|svg|webp|woff2|woff|ttf|eot)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>

    # HLS Media Chunks: fast delivery with CORS enabled
    <FilesMatch "\.(m3u8|ts)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------------------------
# 7. CUSTOM ERROR DOCUMENTS
# ------------------------------------------------------------------------------
ErrorDocument 400 error
ErrorDocument 401 error
ErrorDocument 403 error
ErrorDocument 404 error
ErrorDocument 500 error
ErrorDocument 503 error
