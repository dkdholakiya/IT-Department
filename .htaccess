# Apache Configuration — GMIU IT Portal Live Server Readiness (FastRoute Architecture)

# 1. Prevent Directory Indexing (Directory Browsing)
Options -Indexes

# 2. Block direct web access to sensitive config files & internal formats
<FilesMatch "(\.env|\.sql|\.lock|\.log|\.md|\.sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block hidden files (.git, etc.)
RedirectMatch 403 /\..*$

# 3. URL Rewriting System (FastRoute Front Controller)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to critical framework folders
    RewriteRule ^(App|Core|config|routes|vendor)/ - [F,L]

    # Allow direct access to existing static files (CSS, JS, images, fonts, uploads)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} \.(css|js|ico|png|jpe?g|gif|svg|webp|woff2?|ttf|eot|xlsx?|pdf|zip|mp4|webm|ogg|mov|m4v)$ [NC]
    RewriteRule ^ - [L]

    # Route all other web requests through index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# 4. Custom Error Documents
ErrorDocument 400 error
ErrorDocument 401 error
ErrorDocument 403 error
ErrorDocument 404 error
ErrorDocument 500 error
ErrorDocument 503 error

# 5. Live Server Speed Optimization: Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Smart Browser Asset Caching (Versioned assets with v_asset query parameter cache instantly)
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|ico|png|jpg|jpeg|svg|woff2)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
    </FilesMatch>
</IfModule>
